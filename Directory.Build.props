<Project>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>CS8600;CS8602;CS8603;CS4014</WarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      Lets the net8.0-windows (WPF) projects restore and build on Linux/macOS.
      The XAML markup compiler is managed code and runs cross-platform; only the
      resulting apphost is platform-specific, so `dotnet publish -r win-x64`
      is what produces a runnable .exe. See docs/BUILDING.md.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <Version>1.0.0</Version>
    <Authors>Alikamran Rzayev</Authors>
    <Product>Foxy Overlay</Product>
    <RepositoryUrl>https://github.com/alik-r/foxy-overlay</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
