<Window x:Class="FoxyOverlay.Media.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Foxy Overlay"
        Height="560" Width="500"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E"
        Foreground="#FFEEEEEE">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEEEEEE" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFEEEEEE" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9A9A9A" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE87D3E" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Style="{StaticResource Heading}" Text="ODDS" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Chance per second:  1 in" />
                    <TextBox x:Name="ChanceBox" Width="90" Margin="8,0"
                             TextChanged="onChanceChanged" />
                </StackPanel>
                <TextBlock x:Name="OddsHint" Style="{StaticResource Hint}" />

                <TextBlock Style="{StaticResource Heading}" Text="PLAYBACK" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Cooldown after a scare:" />
                    <TextBox x:Name="CooldownBox" Width="60" Margin="8,0" />
                    <TextBlock Text="seconds" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Size on screen:" />
                    <Slider x:Name="SizeSlider" Width="180" Margin="8,0"
                            Minimum="0.1" Maximum="1.0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            ValueChanged="onSizeChanged" />
                    <TextBlock x:Name="SizeLabel" MinWidth="48" />
                </StackPanel>
                <CheckBox x:Name="MuteCheck" Content="Mute audio" />
                <CheckBox x:Name="AllMonitorsCheck" Content="Show on all monitors" />

                <TextBlock Style="{StaticResource Heading}" Text="VIDEO" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="PackBox" Width="330" Margin="0,0,8,0"
                             ToolTip="A baked pack folder, or a green-screen video to bake" />
                    <Button Content="Browse..." Padding="10,3" Click="onBrowse" />
                </StackPanel>
                <TextBlock x:Name="PackHint" Style="{StaticResource Hint}" />

                <TextBlock Style="{StaticResource Heading}" Text="STARTUP" />
                <CheckBox x:Name="EnabledCheck" Content="Jumpscares enabled" />
                <CheckBox x:Name="AutoStartCheck" Content="Start with Windows" />

                <TextBlock Style="{StaticResource Heading}" Text="STATS" />
                <TextBlock x:Name="StatsText" Style="{StaticResource Hint}" FontStyle="Normal" />

                <TextBlock Style="{StaticResource Heading}" Text="FILES" />
                <TextBlock x:Name="PathsText" Style="{StaticResource Hint}" FontSize="11" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Open data folder" Padding="10,3" Click="onOpenDataFolder" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,0,12,0" />
            <Button Content="Test now" Padding="14,5" Margin="4,0" Click="onTest" />
            <Button Content="Save" Padding="20,5" Margin="4,0" Click="onSave" IsDefault="True" />
            <Button Content="Close" Padding="14,5" Margin="4,0" Click="onClose" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
